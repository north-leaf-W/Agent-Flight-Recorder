# AFR only listens on loopback in the MVP.
AFR_HOST=127.0.0.1
AFR_PORT=4317
AFR_DATA_DIR=.afr
AFR_STORE_MODEL_CONTENT=true
# Optional override when `codex` is not on PATH.
AFR_CODEX_BIN=codex
# Comma-separated local Git worktree roots allowed by the Hosted Web launcher.
# Defaults to the directory from which AFR was launched.
AFR_HOSTED_PROJECT_ROOTS=
# Empty means deny all. Exact hosts and explicit subdomain wildcards (*.example.com) are supported.
AFR_NETWORK_READ_ALLOWLIST=
# Provider control-channel hostnames for H8-C smoke and H9 Web-launched Hosted Runs.
# No universal default exists; discover and review the destinations used by your own
# Codex account/runtime first. The H9 launcher fails closed while this is empty.
AFR_PROVIDER_EGRESS_ALLOWLIST=
# Optional comma-separated exact RFC1918 address pins for an enterprise Provider hostname.
# Never enter a subnet or copy another environment's address.
AFR_PROVIDER_EGRESS_TRUSTED_PRIVATE_ADDRESSES=
# Optional opt-in for enterprise synthetic DNS answers in 198.18.0.0/15.
AFR_PROVIDER_EGRESS_ALLOW_SYNTHETIC_DNS=false
